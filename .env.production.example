# Core app
NODE_ENV=production
PORT=3000

# Auth / session
JWT_SECRET=change-me-to-a-long-random-secret
VITE_APP_ID=dom
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=your-owner-open-id

# Database
DATABASE_URL=mysql://root:password@db:3306/ficha_tecnica?charset=utf8mb4

# Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fichas-tecnicas
S3_FORCE_PATH_STYLE=true

# Redis
REDIS_URL=redis://redis:6379

# Forge / external APIs
BUILT_IN_FORGE_API_URL=https://api.example.com
BUILT_IN_FORGE_API_KEY=change-me

